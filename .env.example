# PC2YOU-APRESENTACAO — copy to `.env` (never commit `.env`). Compose reads it automatically.

DEMO_MODE=true

# Ports on the host (distinct from the full project: 5173/8001-8003)
DEMO_FRONTEND_PORT=5174
DEMO_CATALOG_PORT=8012
DEMO_AI_PORT=8013

# URLs the BROWSER uses to reach the APIs (baked into the frontend build). Change for a public deploy.
PUBLIC_CATALOG_API_URL=http://localhost:8012
PUBLIC_AI_API_URL=http://localhost:8013
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

POSTGRES_USER=orcapc_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=orcapc_db
MONGO_DB=orcapc_catalog

# AI (the main live integration). Server side only.
AI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=45
AI_CACHE_TTL_SECONDS=300
AI_REQUESTS_PER_MINUTE=10

# Optional — Mercado Livre Product API (the demo works with the stored enrichment without these)
MERCADO_LIVRE_ACCESS_TOKEN=
MERCADO_LIVRE_REFRESH_TOKEN=
MERCADO_LIVRE_CLIENT_ID=
MERCADO_LIVRE_CLIENT_SECRET=

# Optional — only with `docker compose --profile telegram up`
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_ALLOWED_CHATS=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
